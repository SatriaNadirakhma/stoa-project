---
// AppPreview.astro — App preview with macOS window, mini previews, and accent switcher
---

<section id="preview" class="relative section-gap bg-stoa-bg overflow-hidden">
  <div class="container-stoa text-center">
    <!-- Section Label -->
    <p class="inline-flex items-center gap-sm text-caption font-body font-medium uppercase tracking-[0.12em] text-stoa-accent mb-xl">
      <span class="block w-4 h-px bg-stoa-accent"></span>
      Preview
    </p>

    <!-- Title -->
    <h2 class="font-display font-normal text-title mb-lg">
      Designed for the way<br />you actually work.
    </h2>

    <!-- Subtitle -->
    <p class="font-body font-light text-[17px] leading-relaxed text-stoa-muted max-w-[500px] mx-auto mb-3xl">
      Dark by default. Keyboard-first. Four accent colors to choose from.
      Exactly as minimal as it needs to be.
    </p>

    <!-- Main macOS Window Mockup -->
    <div class="max-w-[960px] mx-auto mb-3xl">
      <div class="bg-[#0F0F0F] rounded-[14px] border border-stoa-border overflow-hidden"
        style="box-shadow: 0 40px 120px rgba(0,0,0,0.8), 0 0 0 1px var(--color-stoa-border)">
        <!-- Title bar -->
        <div class="flex items-center gap-sm px-lg py-sm bg-stoa-surface2/50 border-b border-stoa-border">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-[#FF5F57]"></div>
            <div class="w-3 h-3 rounded-full bg-[#FEBC2E]"></div>
            <div class="w-3 h-3 rounded-full bg-[#28C840]"></div>
          </div>
          <p class="flex-1 text-center font-body font-normal text-xs text-stoa-muted">Stoa</p>
          <div class="w-[52px]"></div>
        </div>
        <!-- Content -->
        <div class="p-2xl md:p-3xl">
          <p class="font-display font-light text-[22px] text-stoa-text mb-2xl text-left">Good evening, Rizky.</p>
          <div class="space-y-md">
            <!-- Task items -->
            <div class="flex items-center gap-md py-md border-b border-stoa-border">
              <div class="w-5 h-5 rounded-full border border-stoa-border-light flex-shrink-0"></div>
              <div class="flex-1">
                <p class="font-body font-normal text-[15px] text-stoa-text text-left">Revisi proposal skripsi</p>
                <p class="font-body font-light text-xs text-stoa-dim">Due today · ⚡ High</p>
              </div>
            </div>
            <div class="flex items-center gap-md py-md border-b border-stoa-border">
              <div class="w-5 h-5 rounded-full border border-stoa-border-light flex-shrink-0"></div>
              <div class="flex-1">
                <p class="font-body font-normal text-[15px] text-stoa-text text-left">Design landing page</p>
                <p class="font-body font-light text-xs text-stoa-dim">Due tomorrow · 🌿 Medium</p>
              </div>
            </div>
            <div class="flex items-center gap-md py-md border-b border-stoa-border">
              <div class="w-5 h-5 rounded-full bg-stoa-accent/30 border border-stoa-accent-dim flex-shrink-0 flex items-center justify-center">
                <svg width="10" height="10" viewBox="0 0 10 10"><path d="M1.5 5L4 7.5L8.5 2.5" stroke="#A89268" stroke-width="1.5" fill="none"/></svg>
              </div>
              <div class="flex-1">
                <p class="font-body font-normal text-[15px] text-stoa-muted line-through text-left">Respond to emails</p>
              </div>
            </div>
          </div>
          <!-- Bottom bar -->
          <div class="flex items-center justify-between mt-xl pt-md border-t border-stoa-border">
            <div class="flex gap-sm">
              <span class="px-md py-xs rounded-full bg-stoa-accent/10 border border-stoa-accent-dim text-xs font-mono text-stoa-accent">Focus</span>
              <span class="px-md py-xs rounded-full bg-stoa-surface2 border border-stoa-border text-xs font-mono text-stoa-muted">Vault</span>
              <span class="px-md py-xs rounded-full bg-stoa-surface2 border border-stoa-border text-xs font-mono text-stoa-muted">Reflect</span>
            </div>
            <span class="font-mono text-mono text-stoa-dim">3/5 today</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Mini Previews -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-lg max-w-[960px] mx-auto mb-3xl">
      <!-- Focus Mode -->
      <div data-animate data-animate-delay="0" class="bg-stoa-surface border border-stoa-border rounded-[14px] p-lg text-center hover:scale-[1.02] hover:shadow-lg transition-all duration-300 cursor-default">
        <p class="font-body font-medium text-sm text-stoa-muted uppercase tracking-[0.06em] mb-md">Focus Mode</p>
        <p class="font-mono text-[32px] text-stoa-accent">25:00</p>
        <p class="font-body font-light text-xs text-stoa-dim mt-sm">One task. Deep work.</p>
      </div>
      <!-- The Vault -->
      <div data-animate data-animate-delay="80" class="bg-stoa-surface border border-stoa-border rounded-[14px] p-lg text-center hover:scale-[1.02] hover:shadow-lg transition-all duration-300 cursor-default">
        <p class="font-body font-medium text-sm text-stoa-muted uppercase tracking-[0.06em] mb-md">The Vault</p>
        <div class="space-y-xs text-left">
          <p class="font-body font-normal text-xs text-stoa-text pl-sm border-l border-stoa-accent">⚡ 4 tasks</p>
          <p class="font-body font-normal text-xs text-stoa-text pl-sm border-l border-stoa-success">🌿 7 tasks</p>
          <p class="font-body font-normal text-xs text-stoa-muted pl-sm border-l border-stoa-border">🌙 3 tasks</p>
        </div>
      </div>
      <!-- Evening Reflection -->
      <div data-animate data-animate-delay="160" class="bg-stoa-surface border border-stoa-border rounded-[14px] p-lg text-center hover:scale-[1.02] hover:shadow-lg transition-all duration-300 cursor-default">
        <p class="font-body font-medium text-sm text-stoa-muted uppercase tracking-[0.06em] mb-md">Reflection</p>
        <div class="flex items-center justify-center gap-sm">
          <div class="w-2 h-2 rounded-full bg-stoa-accent"></div>
          <div class="w-2 h-2 rounded-full bg-stoa-accent"></div>
          <div class="w-2 h-2 rounded-full bg-stoa-accent"></div>
          <div class="w-2 h-2 rounded-full bg-stoa-border"></div>
          <div class="w-2 h-2 rounded-full bg-stoa-border"></div>
        </div>
        <p class="font-body font-light text-xs text-stoa-dim mt-sm">3 of 5 completed</p>
      </div>
    </div>

    <!-- Accent Color Switcher -->
    <div class="text-center">
      <p class="font-body font-medium text-caption uppercase tracking-[0.08em] text-stoa-muted mb-md">Choose your accent</p>
      <div class="flex items-center justify-center gap-md">
        <button
          type="button"
          class="accent-swatch w-8 h-8 rounded-full border-2 border-stoa-border hover:scale-110 transition-all duration-200 cursor-pointer"
          style="background-color: #A89268; border-color: var(--color-stoa-accent)"
          data-accent="#A89268"
          data-accent-dim="#6B5E42"
          title="Stone"
          aria-label="Stone accent"
        ></button>
        <button
          type="button"
          class="accent-swatch w-8 h-8 rounded-full border-2 border-stoa-border hover:scale-110 transition-all duration-200 cursor-pointer"
          style="background-color: #6B8F71"
          data-accent="#6B8F71"
          data-accent-dim="#4A6B50"
          title="Forest"
          aria-label="Forest accent"
        ></button>
        <button
          type="button"
          class="accent-swatch w-8 h-8 rounded-full border-2 border-stoa-border hover:scale-110 transition-all duration-200 cursor-pointer"
          style="background-color: #8B7BA8"
          data-accent="#8B7BA8"
          data-accent-dim="#6A5C85"
          title="Dusk"
          aria-label="Dusk accent"
        ></button>
        <button
          type="button"
          class="accent-swatch w-8 h-8 rounded-full border-2 border-stoa-border hover:scale-110 transition-all duration-200 cursor-pointer"
          style="background-color: #7890A8"
          data-accent="#7890A8"
          data-accent-dim="#5A7088"
          title="Ink"
          aria-label="Ink accent"
        ></button>
      </div>
    </div>
  </div>
</section>

<script>
  const swatches = document.querySelectorAll('.accent-swatch');
  const root = document.documentElement;
  const defaultAccent = '#A89268';
  const defaultAccentDim = '#6B5E42';
  const defaultGlow = 'rgba(168, 146, 104, 0.12)';

  swatches.forEach(swatch => {
    swatch.addEventListener('click', () => {
      const accent = swatch.getAttribute('data-accent') || defaultAccent;
      const accentDim = swatch.getAttribute('data-accent-dim') || defaultAccentDim;

      // Parse RGB from hex for glow calculation
      const r = parseInt(accent.slice(1, 3), 16);
      const g = parseInt(accent.slice(3, 5), 16);
      const b = parseInt(accent.slice(5, 7), 16);
      const glow = `rgba(${r}, ${g}, ${b}, 0.12)`;

      root.style.setProperty('--color-accent', accent);
      root.style.setProperty('--color-accent-glow', glow);
      root.style.setProperty('--color-stoa-accent', accent);
      root.style.setProperty('--color-stoa-accent-dim', accentDim);

      // Update active swatch border
      swatches.forEach(s => {
        (s as HTMLElement).style.borderColor = 'var(--color-stoa-border)';
      });
      (swatch as HTMLElement).style.borderColor = accent;
    });
  });
</script>
