---
// Arch SVG — Classical Roman/Greek arch line art
// Used as decorative bookend in Hero and Download CTA sections
---

<svg
  class="arch-svg absolute inset-0 w-full h-full pointer-events-none select-none"
  viewBox="0 0 600 700"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Left column -->
  <rect
    x="120"
    y="280"
    width="28"
    height="240"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <!-- Right column -->
  <rect
    x="452"
    y="280"
    width="28"
    height="240"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <!-- Left column capital (ionic volute hint) -->
  <path
    d="M116 280 C116 260, 152 260, 152 280"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <path
    d="M116 280 C116 268, 152 268, 152 280"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <!-- Right column capital -->
  <path
    d="M448 280 C448 260, 484 260, 484 280"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <path
    d="M448 280 C448 268, 484 268, 484 280"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <!-- Left column base -->
  <line
    x1="116"
    y1="520"
    x2="152"
    y2="520"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <line
    x1="118"
    y1="528"
    x2="150"
    y2="528"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <!-- Right column base -->
  <line
    x1="448"
    y1="520"
    x2="484"
    y2="520"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <line
    x1="450"
    y1="528"
    x2="482"
    y2="528"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <!-- Arch (semicircular top) -->
  <path
    d="M 134 280 C 134 100, 466 100, 466 280"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <!-- Inner arch line -->
  <path
    d="M 148 280 C 148 120, 452 120, 452 280"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <!-- Entablature / horizontal beam above columns -->
  <line
    x1="100"
    y1="260"
    x2="500"
    y2="260"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
