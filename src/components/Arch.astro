  <path
    d="M 100 252 L 300 160 L 500 252"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
  />
  <!-- Floor line -->
  <line
    x1="80"
    y1="540"
    x2="520"
    y2="540"
    stroke="currentColor"
    stroke-width="1"
    class="text-stoa-border-light"
