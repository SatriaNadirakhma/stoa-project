---
// Footer.astro — Site footer
---

<footer class="border-t border-stoa-border py-3xl bg-stoa-bg">
  <div class="container-stoa">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-2xl">
      <!-- Left: Brand -->
      <div>
        <div class="flex items-center gap-sm mb-sm">
          <span class="text-[22px] font-display font-normal text-stoa-text leading-none">
            Stoa
          </span>
          <span class="font-mono text-[11px] text-stoa-dim border border-stoa-border rounded-sm px-1.5 py-px leading-none">
            macOS
          </span>
        </div>
        <p class="font-body font-light text-[13px] text-stoa-dim mb-sm">
          &ldquo;Built with intention. Designed for focus.&rdquo;
        </p>
        <p class="font-body font-light text-[13px] text-stoa-dim">
          &copy; 2025 Stoa. Made for macOS.
        </p>
      </div>

      <!-- Center: Links -->
      <div class="flex flex-wrap gap-x-xl gap-y-sm md:justify-center">
        <a href="#features" class="font-body font-normal text-[13px] text-stoa-muted hover:text-stoa-text transition-colors">Features</a>
        <a href="#how-it-works" class="font-body font-normal text-[13px] text-stoa-muted hover:text-stoa-text transition-colors">How It Works</a>
        <a href="#preview" class="font-body font-normal text-[13px] text-stoa-muted hover:text-stoa-text transition-colors">Preview</a>
        <a href="#" class="font-body font-normal text-[13px] text-stoa-muted hover:text-stoa-text transition-colors">Privacy Policy</a>
      </div>

      <!-- Right: Academy attribution -->
      <div class="md:text-right">
        <p class="font-body font-light text-[13px] text-stoa-muted mb-xs">
          Applying to Apple Developer Academy
        </p>
        <p class="font-body font-light text-[13px] text-stoa-dim">
          Universitas Ciputra Surabaya · 2025
        </p>
      </div>
    </div>
  </div>
</footer>
